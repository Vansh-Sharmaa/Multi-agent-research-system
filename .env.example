# Intellecta Multi-Agent Research System - Environment Variables
# Copy this file to .env and fill in your values

# Tavily API Key (required for web search)
# Get free API key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Optional: Logging
LOG_LEVEL=INFO

# Optional: Docker Hub (for CI/CD deployment)
# DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_token

# Optional: Streamlit Cloud Deploy Hook
# STREAMLIT_DEPLOY_HOOK=https://streamlit.io/deploy/webhook/...

# Optional: Slack Webhook for notifications
# SLACK_WEBHOOK=https://hooks.slack.com/services/...